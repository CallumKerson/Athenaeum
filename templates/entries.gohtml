{{define "content"}}
      <ul class="entries">
        {{- range .Entries}}
        <li data-search="{{.Search}}">
          <a class="name" href="{{.Href}}">{{.Name}}</a>
          <span class="count">{{.Count}} {{if eq .Count 1}}book{{else}}books{{end}}{{with .Hours}}, {{.}}h{{end}}</span>
          {{- with .FeedHref}}
          <span class="feed"><a class="feed-link" href="{{.}}">RSS</a><button class="copy" type="button" hidden>Copy</button></span>
          {{- end}}
        </li>
        {{- end}}
      </ul>
{{- end}}
