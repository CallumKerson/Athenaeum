{{define "head"}}
{{- with .Home}}
      <section class="hero">
        <div>
          <h1>{{.Books}} audiobooks, ready for your podcast app</h1>
          <p class="lede">{{.Hours}} hours of listening. Played end to end, that is {{.Days}} days without a break.</p>
          {{- with $.FeedHref}}
          <p class="subscribe"><a class="feed-link button" href="{{.}}">Subscribe to every book</a><button class="copy" type="button" hidden>Copy feed URL</button><a class="overcast" hidden>Add to Overcast</a></p>
          {{- end}}
        </div>
        {{- if .Mosaic}}
        <div class="mosaic" aria-hidden="true">
          {{- range .Mosaic}}
          <a href="{{.Href}}" tabindex="-1">{{template "cover" .}}</a>
          {{- end}}
        </div>
        {{- end}}
      </section>
{{- end}}
{{- end}}

{{define "content"}}
{{- with .Home}}
      {{- if .Latest}}
      <section>
        <div class="section-head"><h2>Latest releases</h2><a href="books/">See every book</a></div>
        <ul class="books shelf">
          {{- range .Latest}}
          <li class="tile">
            <a href="{{.Href}}">{{template "cover" .}}<span class="t">{{.Title}}</span></a>
            {{- if .Authors}}<span class="a">{{template "links" .Authors}}</span>{{end}}
            {{- template "duration" .Duration}}
          </li>
          {{- end}}
        </ul>
      </section>
      {{- end}}
      {{- if .Genres}}
      <section>
        <div class="section-head"><h2>Genres</h2><a href="genre/">Every genre</a></div>
        <ul class="genres">
          {{- range .Genres}}
          <li>
            <a href="{{.Href}}">
              <span class="stack" aria-hidden="true">{{range .Covers}}<img src="{{.}}" alt="" width="52" height="52" loading="lazy" decoding="async" />{{end}}</span>
              <span><b>{{.Name}}</b><small>{{.Count}} {{if eq .Count 1}}book{{else}}books{{end}}, {{.Hours}} hours</small></span>
            </a>
          </li>
          {{- end}}
        </ul>
      </section>
      {{- end}}
{{- end}}
{{- end}}
