{{define "layout" -}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{.Title}}</title>
    <link rel="preload" href="{{.Root}}static/figtree.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="{{.Root}}static/literata.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="{{.Root}}static/site.css" />
    {{- with .FeedHref}}
    <link rel="alternate" type="application/rss+xml" title="{{$.Heading}}" href="{{.}}" />
    {{- end}}
  </head>

  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="{{.Root}}">Athenaeum</a>
        <nav aria-label="Sections">
          {{- range .Nav}}
          <a href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Name}}</a>
          {{- end}}
        </nav>
      </div>
    </header>

    <main class="wrap">
      {{- if not .Home}}{{template "head" .}}{{end}}
      {{- if .Search}}
      <form class="search" onsubmit="return false" hidden>
        <input id="filter" type="search" placeholder="{{.SearchLabel}}" aria-label="{{.SearchLabel}}" autocomplete="off" spellcheck="false" />
        <span id="filter-count"></span>
      </form>
      {{- end}}
      {{- template "content" .}}
    </main>

    <footer class="wrap">
      Built by <a href="https://github.com/CallumKerson/Athenaeum">Athenaeum</a>.
    </footer>

    <script>
      // The feed URL a podcast app needs is absolute, and the links on the page are
      // relative so that the site works wherever it is mounted — so resolve against
      // the current location rather than baking a host into the page.
      function feedURL(link) {
        return new URL(link.getAttribute("href"), location.href).href;
      }
      document.querySelectorAll("button.copy").forEach(function (button) {
        button.hidden = false;
      });
      document.querySelectorAll("a.overcast").forEach(function (link) {
        const feed = link.parentElement.querySelector("a.feed-link");
        link.href = "overcast://x-callback-url/add?url=" + encodeURIComponent(feedURL(feed));
        link.hidden = false;
      });
      document.addEventListener("click", function (event) {
        const button = event.target.closest("button.copy");
        if (!button) return;
        const url = feedURL(button.parentElement.querySelector("a.feed-link"));
        navigator.clipboard.writeText(url).then(
          function () { flash(button, "Copied"); },
          function () { flash(button, "Copy failed"); }
        );
      });
      function flash(button, message) {
        const original = button.textContent;
        button.textContent = message;
        setTimeout(function () { button.textContent = original; }, 1500);
      }
    </script>
    {{- if .Search}}
    <script>
      const form = document.querySelector("form.search");
      const input = document.getElementById("filter");
      const counter = document.getElementById("filter-count");
      const rows = Array.from(document.querySelectorAll("[data-search]"));
      form.hidden = false;

      function apply() {
        const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const row of rows) {
          const match = terms.every(function (term) { return row.dataset.search.includes(term); });
          row.hidden = !match;
          if (match) shown++;
        }
        counter.textContent = terms.length ? shown + " of " + rows.length : "";
      }

      input.addEventListener("input", apply);
      // Prefill from ?q= so a search can be linked to or bookmarked.
      input.value = new URLSearchParams(location.search).get("q") || "";
      apply();
    </script>
    {{- end}}
  </body>
</html>
{{- end}}

{{/* The page's heading, blurb and feed. The home page leaves it out for its own hero, and a
     book page, which leaves Heading empty, puts its title beside the cover instead. */}}
{{define "head"}}
      {{- with .Heading}}
      <h1>{{.}}</h1>
      {{- end}}
      {{- with .Blurb}}
      <p class="blurb">{{.}}</p>
      {{- end}}
      {{- with .FeedHref}}
      {{template "subscribe" .}}
      {{- end}}
{{- end}}

{{/* Ways to subscribe to the feed at the given link. The buttons need script, so they start hidden. */}}
{{define "subscribe"}}
      <p class="subscribe"><a class="feed-link" href="{{.}}">Subscribe to this feed</a><button class="copy" type="button" hidden>Copy feed URL</button><a class="overcast" hidden>Add to Overcast</a></p>
{{- end}}

{{define "links"}}{{range $index, $link := .}}{{if $index}}, {{end}}{{if $link.Href}}<a href="{{$link.Href}}">{{$link.Name}}</a>{{else}}{{$link.Name}}{{end}}{{end}}{{end}}

{{define "duration"}}{{with .}}<span class="len">{{.}}</span>{{end}}{{end}}

{{define "cover"}}{{if .Cover}}<img class="cover" src="{{.Cover}}" alt="" width="160" height="160" loading="lazy" decoding="async" />{{else}}<span class="cover blank" aria-hidden="true"><b>{{.Title}}</b></span>{{end}}{{end}}

{{define "booklist"}}
{{- if .Books}}
      <ul class="books">
        {{- range .Books}}
        <li class="tile" data-search="{{.Search}}">
          <a href="{{.Href}}">{{template "cover" .}}<span class="t">{{.Title}}</span></a>
          {{- if .Authors}}<span class="a">{{template "links" .Authors}}</span>{{end}}
          {{- template "duration" .Duration}}
        </li>
        {{- end}}
      </ul>
{{- else}}
      <p class="empty">No books here yet.</p>
{{- end}}
{{- end}}
